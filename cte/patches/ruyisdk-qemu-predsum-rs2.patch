From 1e9c9069a51a9235405991c46efcdef19789189e Mon Sep 17 00:00:00 2001
From: Zeyi Xu <zeyi2@nekoarch.cc>
Date: Sun, 15 Nov 2026 07:43:12 +0000
Subject: [PATCH] target/riscv: fix predsum.bs/hs rs2 truncation on RV64

Signed-off-by: Zeyi Xu <zeyi2@nekoarch.cc>
---
 target/riscv/tcg/psimd_helper.c | 4 ++--
 tests/tcg/riscv/psimd-common.S  | 8 ++++++++
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/target/riscv/tcg/psimd_helper.c b/target/riscv/tcg/psimd_helper.c
index a3bf374..518bb30 100644
--- a/target/riscv/tcg/psimd_helper.c
+++ b/target/riscv/tcg/psimd_helper.c
@@ -2470,11 +2470,11 @@ GEN_PSIMD_XPAIR_AVG_BINOP(pasa_wx, uint64_t, int32_t, int64_t,
 /* Horizontal sum operations */
 
 GEN_PSIMD_REDSUM(predsum_bs, target_ulong, int64_t, int8_t,
-                 EXTRACT8, ELEMS_B, (int64_t)(int32_t)rs2)
+                 EXTRACT8, ELEMS_B, (int64_t)(target_long)rs2)
 GEN_PSIMD_REDSUM(predsumu_bs, target_ulong, uint64_t, uint8_t,
                  EXTRACT8, ELEMS_B, rs2)
 GEN_PSIMD_REDSUM(predsum_hs, target_ulong, int64_t, int16_t,
-                 EXTRACT16, ELEMS_H, (int64_t)(int32_t)rs2)
+                 EXTRACT16, ELEMS_H, (int64_t)(target_long)rs2)
 GEN_PSIMD_REDSUM(predsumu_hs, target_ulong, uint64_t, uint16_t,
                  EXTRACT16, ELEMS_H, rs2)
 GEN_PSIMD_REDSUM(predsum_ws, uint64_t, int64_t, int32_t,
diff --git a/tests/tcg/riscv/psimd-common.S b/tests/tcg/riscv/psimd-common.S
index 07e14e7..7a73da1 100644
--- a/tests/tcg/riscv/psimd-common.S
+++ b/tests/tcg/riscv/psimd-common.S
@@ -650,6 +650,14 @@
     TEST_PSIMD_RR_SET 155, predsumu.bs, 0x807f02ff01807f02, \
                        0x64, 0x366
     TEST_PSIMD_RR_SET 156, predsum.hs, 0x0003000400010002, 0xa, 0x14
+    /* rs2 is a full XLEN accumulator, not a sign-extended low word. */
+    TEST_PSIMD_RR 154, predsum.bs, 0x8080808080808080, \
+                  0x8000000000000000, 0x7ffffffffffffc00
+    TEST_PSIMD_RR 154, predsum.bs, 0x7f80ff01fe027d83, -5, -6
+    TEST_PSIMD_RR 156, predsum.hs, 0, 0x7fffffffffffffff, \
+                  0x7fffffffffffffff
+    TEST_PSIMD_RR 156, predsum.hs, 0x1234fedc8001ffff, \
+                  0x123456789abcdef0, 0x123456789abc7000
     TEST_PSIMD_RR_SET 157, predsumu.hs, 0x1000200030004000, \
                        0x1000, 0xb000
     TEST_PSIMD_RR_SET 159, predsum.ws, 0x7fffffff00000005, \
-- 
2.55.0

